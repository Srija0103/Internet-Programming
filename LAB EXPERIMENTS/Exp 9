<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><title>TechSavvy Store</title></head>
<body>
  <h1>TechSavvy</h1>
  <nav>Phones | Laptops | Tablets | Accessories</nav>
  <form>
    <input type="search" placeholder="Search products">
    <select><option>Category</option><option>Phones</option><option>Laptops</option></select>
    <button>Search</button>
  </form>
  <h2>Products</h2>
  <p>Smartphone — ₹25,000 — In stock</p>
  <button>Add to Cart</button>
  <h2>Shopping Cart</h2>
  <p>Smartphone × 1 — ₹25,000</p>
  <button>Checkout</button>
  <p>Login / Register · Wishlist · Order history · Track order</p>
  <h2>Admin</h2>
  <form>
    <input placeholder="Product name"><input type="number" placeholder="Price">
    <textarea placeholder="Description"></textarea>
    <button>Add / Update Product</button><button>Remove Product</button>
  </form>
</body>
</html>
