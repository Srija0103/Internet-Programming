<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><title>StyleHub</title></head>
<body>
  <h1>StyleHub Fashion</h1>
  <nav>Women | Men | Children | Shoes | Accessories</nav>
  <form>
    <input type="search" placeholder="Search clothing">
    <select><option>Category</option><option>Casual</option><option>Formal</option></select>
    <select><option>Size</option><option>S</option><option>M</option><option>L</option></select>
    <button>Search</button>
  </form>
  <h2>Featured Products</h2>
  <p>Casual Shirt — ₹1,200 — Sizes S, M, L</p>
  <button>Add to Cart</button>
  <h2>Shopping Cart</h2>
  <p>Casual Shirt × 1 — ₹1,200</p>
  <button>Checkout</button>
  <p>Login / Register · Wishlist · Reviews · Order tracking · Returns</p>
  <h2>Admin</h2>
  <form>
    <input placeholder="Product name"><input type="number" placeholder="Price">
    <textarea placeholder="Description"></textarea>
    <button>Add / Update Product</button><button>Remove Product</button>
  </form>
</body>
</html>
